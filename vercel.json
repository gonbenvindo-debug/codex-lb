{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/app/static/assets/$1"
    },
    {
      "source": "/fonts/(.*)",
      "destination": "/app/static/fonts/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/app/static/favicon.svg"
    }
  ]
}
